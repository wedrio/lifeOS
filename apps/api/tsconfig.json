{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@lifeos/shared": ["packages/shared/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src"]
}
