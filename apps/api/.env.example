# PostgreSQL 16 + pgvector (see docker-compose.yml)
DATABASE_URL="postgresql://lifeos:lifeos_dev_password@localhost:5432/lifeos?schema=public"

# Replace before any non-local deployment. Must be at least 32 characters.
JWT_SECRET="replace-this-development-secret-with-a-long-random-value"
CORS_ORIGIN="http://localhost:5173"
# access token 有效期（15m/30m/7d 等）。桌面/手机端跨站拿不到 refresh cookie，生产建议 7d
ACCESS_TOKEN_TTL="15m"
APP_TIMEZONE="Asia/Shanghai"
PORT=3000
NODE_ENV=development
