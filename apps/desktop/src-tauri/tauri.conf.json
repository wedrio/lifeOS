{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lifeOS",
  "version": "0.1.0",
  "identifier": "com.lifeos.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @lifeos/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @lifeos/web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "lifeOS",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
