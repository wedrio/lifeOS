# 多阶段：Node 构建 web 静态资源 → Caddy 托管
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY . .
# 前端打包固定为 remote 模式、走同源相对 /api（由 Caddy 反代）
# 注意：Vite 只从 .env 文件读取 VITE_ 变量，这里必须生成
RUN printf 'VITE_DATA_SOURCE=remote\nVITE_API_BASE_URL=\n' > apps/web/.env \
 && pnpm install --frozen-lockfile \
 && pnpm --filter @lifeos/web build

FROM caddy:2-alpine
COPY --from=build /app/apps/web/dist /srv/lifeos
